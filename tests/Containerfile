# Fedora with systemd as PID 1, so the playbook can start real services (docker, postgres, valkey).
ARG FEDORA_VERSION=44
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION}
RUN dnf install -y -q systemd sudo ansible-core git python3-libdnf5 procps-ng && dnf clean all \
 && useradd -m -G wheel dev && echo "dev ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/dev \
 && systemctl mask systemd-logind.service getty.target console-getty.service
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
